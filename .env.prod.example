# Copy to .env.prod on the server and fill in real values. Never commit .env.prod.

# Your domain (must point to the server's IP). Caddy issues HTTPS for it.
DOMAIN=tracker.example.com

# Django
SECRET_KEY=generate-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=tracker.example.com,backend
CSRF_TRUSTED_ORIGINS=https://tracker.example.com
TIME_ZONE=Europe/Moscow

# Database — keep these three in sync with DATABASE_URL.
POSTGRES_USER=timetracker
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=timetracker
DATABASE_URL=postgres://timetracker:change-this-strong-password@db:5432/timetracker

# Public site. DOMAIN comes from the environment; defaults to localhost (http).
# With a real domain on ports 80/443, Caddy gets an HTTPS certificate automatically.
{$DOMAIN:localhost} {
	encode gzip

	# Django API, admin and its static files go to the backend.
	@backend path /api/* /admin/* /static/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# Everything else is the React single-page app.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
